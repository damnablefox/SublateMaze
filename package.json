{
  "name": "sublatemaze",
  "version": "0.1.0",
  "private": true,
  "description": "本地优先的个人学习平台与知识库管理系统",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev:kernel": "tsx scripts/check-kernel.ts",
    "bench:vector": "tsx scripts/bench-vector.ts",
    "package:portable": "node scripts/package-portable.mjs",
    "build:native": "napi build --platform --release --cwd crates/sublate-native",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.8",
    "@stylistic/eslint-plugin": "5.10.0",
    "@sublate/core": "workspace:*",
    "@sublate/kernel": "workspace:*",
    "@sublate/plugin-agent": "workspace:*",
    "@sublate/plugin-ai-provider": "workspace:*",
    "@sublate/plugin-course": "workspace:*",
    "@sublate/plugin-demo": "workspace:*",
    "@sublate/plugin-extractor": "workspace:*",
    "@sublate/plugin-importer": "workspace:*",
    "@sublate/plugin-indexer": "workspace:*",
    "@sublate/plugin-native-bridge": "workspace:*",
    "@sublate/plugin-notes": "workspace:*",
    "@sublate/plugin-parser": "workspace:*",
    "@sublate/plugin-planner": "workspace:*",
    "@sublate/plugin-scheduler": "workspace:*",
    "@sublate/plugin-sdk": "workspace:*",
    "@sublate/plugin-search": "workspace:*",
    "@sublate/plugin-session": "workspace:*",
    "@sublate/plugin-sets": "workspace:*",
    "@sublate/plugin-storage-lancedb": "workspace:*",
    "@sublate/plugin-storage-sqlite": "workspace:*",
    "@sublate/plugin-study-tools": "workspace:*",
    "@sublate/plugin-tools": "workspace:*",
    "@sublate/plugin-vault": "workspace:*",
    "@sublate/shared": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "oxlint": "1.89.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  }
}
