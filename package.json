{
  "name": "sublatemaze",
  "version": "0.1.0",
  "private": true,
  "description": "本地优先的个人学习平台与知识库管理系统",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev:kernel": "tsx scripts/check-kernel.ts",
    "build:native": "napi build --platform --release --cwd crates/sublate-native",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.8",
    "@sublate/core": "workspace:*",
    "@sublate/kernel": "workspace:*",
    "@sublate/plugin-agent": "workspace:*",
    "@sublate/plugin-demo": "workspace:*",
    "@sublate/plugin-importer": "workspace:*",
    "@sublate/plugin-native-bridge": "workspace:*",
    "@sublate/plugin-parser": "workspace:*",
    "@sublate/plugin-sdk": "workspace:*",
    "@sublate/plugin-search": "workspace:*",
    "@sublate/plugin-session": "workspace:*",
    "@sublate/plugin-storage-lancedb": "workspace:*",
    "@sublate/plugin-storage-sqlite": "workspace:*",
    "@sublate/plugin-tools": "workspace:*",
    "@sublate/plugin-vault": "workspace:*",
    "@sublate/shared": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "^4.0.0"
  }
}
